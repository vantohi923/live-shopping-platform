{
  "name": "backend",
  "module": "src/index.ts",
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "6"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:seed": "bun prisma/seed.ts",
    "db:test:setup": "bun --env-file=.env.test run prisma migrate deploy",
    "typecheck": "bun check",
    "postinstall": "prisma skills sync || exit 0"
  },
  "type": "module",
  "dependencies": {
    "@prisma/client": "6",
    "zod": "^4.6.7"
  }
}
